# Copy this file to .env and fill in your values
# Get your free Groq API key at: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Model to use (default works great; uncomment an alternative if desired)
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=qwen/qwen3-27b

# Optional: comma-separated fallback model cascade (tried left-to-right on errors).
# If omitted the agent uses the built-in 4-model default cascade.
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
